set $mod Mod4
set $term kitty

font pango:Fira Mono 10
default_border pixel 0
default_floating_border pixel 0
gaps inner 5
gaps outer 5
floating_modifier $mod normal

input * {
  xkb_layout us
  repeat_rate 25
  repeat_delay 600
}

seat * {
  xcursor_theme volantes_cursors 24
}

output eDP-1 bg /home/jee/Wallpaper/gruvbox-bw-4.png fill
output eDP-1 position 0 0
output HDMI-A-1 position 1920 0
output HDMI-A-1 bg /home/jee/Wallpaper/gruvbox-bw-3.png fill

for_window [app_id="pavucontrol"] floating enable
for_window [app_id="mpv"] floating enable
for_window [app_id="mpv"] resize set 1280 720
for_window [title="Picture-in-Picture"] floating enable

bindsym $mod+Return exec $term
bindsym $mod+Escape exit
bindsym $mod+q kill
bindsym $mod+f floating toggle
bindsym $mod+i exec rofi -show drun
bindsym $mod+w exec workspace
bindsym $mod+s exec screenshots
bindsym $mod+o exec powermenu
bindsym $mod+u exec volume up
bindsym $mod+y exec volume down
bindsym $mod+Shift+u exec brightness up
bindsym $mod+Shift+y exec brightness down

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Control+Right resize grow width 100 px
bindsym $mod+Control+Left resize shrink width 100 px
bindsym $mod+Control+Up resize shrink height 100 px
bindsym $mod+Control+Down resize grow height 100 px

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+t workspace back_and_forth

exec mako
exec kitty

# import compositor env (WAYLAND_DISPLAY) into systemd user manager so the
# xdg-desktop-portal GTK backend can open a display and serve file pickers /
# download dialogs (otherwise it dies with "cannot open display")
exec "systemctl --user import-environment; systemctl --user restart xdg-desktop-portal.service"
